# ==========================================
# SMART CAMPUS REST API - BACKEND ENV CONFIG
# ==========================================

# Port (Render / Railway assigns this automatically; default 5000 locally)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# --------------------------------------------------------------------------
# DATABASE CONNECTION STRING (Prisma auto-detects SQLite vs PostgreSQL!)
# --------------------------------------------------------------------------
# Option A (Recommended for Production - Free PostgreSQL on Neon / Supabase / Render Postgres):
# DATABASE_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Option B (Zero-config local development with SQLite):
DATABASE_URL="file:./dev.db"

# --------------------------------------------------------------------------
# AUTHENTICATION (JWT)
# --------------------------------------------------------------------------
# A secure random secret key (minimum 32 characters in production)
JWT_SECRET="smart-campus-super-secret-jwt-key-2026-production-ready"
JWT_EXPIRES_IN="7d"

# --------------------------------------------------------------------------
# CORS / FRONTEND INTEGRATION
# --------------------------------------------------------------------------
# Set to your live Vercel frontend URL, or "*" to allow any domain
# Example: CLIENT_URL="https://smart-campus-frontend.vercel.app"
CLIENT_URL="*"
